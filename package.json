{
  "name": "treffio-shared",
  "version": "0.1.0",
  "description": "Code shared between Treffio apps: block documents, renderers and helpers.",
  "author": "Maincode K/S",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./blocks": {
      "import": {
        "types": "./dist/blocks/index.d.ts",
        "default": "./dist/blocks/index.js"
      },
      "require": {
        "types": "./dist/blocks/index.d.cts",
        "default": "./dist/blocks/index.cjs"
      }
    },
    "./blocks/email-mjml": {
      "import": {
        "types": "./dist/blocks/email-mjml/index.d.ts",
        "default": "./dist/blocks/email-mjml/index.js"
      },
      "require": {
        "types": "./dist/blocks/email-mjml/index.d.cts",
        "default": "./dist/blocks/email-mjml/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "blocks": [
        "./dist/blocks/index.d.ts"
      ],
      "blocks/email-mjml": [
        "./dist/blocks/email-mjml/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "zod": "^4.6.7"
  }
}
